# ===========================================================================
# Open Claude Desktop — environment template
# Copy to ".env" and fill in. Keep .env out of git. Do NOT commit real secrets.
# ===========================================================================

# ── LLM (Z.ai / GLM) ────────────────────────────────────────────────────────
ZHIPU_API_KEY=your_zhipu_api_key
AGENT_MODEL=glm-4-plus
VISION_MODEL=glm-4v-plus
FLASH_MODEL=glm-4-flash

# ── BigQuery / agent behavior ───────────────────────────────────────────────
GCP_PROJECT_ID=ajgc-dig-jwc-prod-jawacloud-01
CATALOG_DATASETS=aj360,aj360platform,aj360searchanalytics,aj360contentanalytics,aljazeeradatamodels,aj360ds,aj360monitoring
MAX_BYTES_BILLED_GB=20
CONFIRM_BYTES_GB=5

# ===========================================================================
# CHAT HISTORY  (needs BOTH this auth block AND the Postgres block below)
# ===========================================================================

# ── Auth: session signing secret (REQUIRED to enable the login gate) ──────────
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_AUTH_SECRET=paste_generated_secret_here   # CHAINLIT_AUTH_SECRET also accepted (back-compat)

# ── Auth: Google OAuth ("Sign in with Google") ───────────────────────────────
# Create a Web OAuth client in Google Cloud Console (APIs & Services → Credentials
# → OAuth client ID → Web application), then paste both values here:
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# Must EXACTLY match an Authorized redirect URI configured on the OAuth client:
OCD_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Where the backend redirects the browser back to after login:
OCD_FRONTEND_URL=http://localhost:3000

# DEPRECATED — username/password auth was removed; these are ignored:
# APP_USERNAME=...
# APP_PASSWORD=...

# ── Postgres data layer ─────────────────────────────────────────────────────
# POSTGRES_PASSWORD is read by docker-compose; DATABASE_URL must match it.
# LEGACY (Chainlit-only, retired in Phase 5): the Chainlit app needs the async
# driver + the "chainlit" database. The ACTIVE app (Reflex / ocd_core) uses the
# ocd DATABASE_URL at the bottom of this file. Only uncomment the line below
# (and comment out the ocd one) if you are running the legacy Chainlit app.
POSTGRES_PASSWORD=changeme
# DATABASE_URL=postgresql+asyncpg://chainlit:changeme@localhost:5432/chainlit
DB_SSL=false

# ===========================================================================
# GCS STORAGE  (for chart images + uploaded files in history)
# ---------------------------------------------------------------------------
# IMPORTANT: Chainlit signs read URLs with generate_signed_url(v4). Plain
#   `gcloud auth application-default login` USER credentials CANNOT sign, so
#   charts/files will fail to display. You need ONE of:
#     (a) a SERVICE ACCOUNT key  -> set the three GCS_* creds below, or
#     (b) run on GCP with a service account that has Storage Object Admin
#         + Service Account Token Creator (then leave the key fields blank;
#         ADC will sign via IAM).
# Leave GCS_BUCKET blank to disable GCS (history then keeps text + tables only,
# chart/file thumbnails won't persist).
# ---------------------------------------------------------------------------
GCS_BUCKET=aj360-chainlit-elements
GCS_PROJECT_ID=ajgc-dig-jwc-prod-jawacloud-01
GCS_CLIENT_EMAIL=chainlit-storage@ajgc-dig-jwc-prod-jawacloud-01.iam.gserviceaccount.com
# Paste the SA private key as ONE line with literal \n escapes:
GCS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n

# ocd_core (Phase 2) persistence — sync psycopg driver, dedicated "ocd" role + database
# (created by backend/db_init/01_create_ocd.sql on first Postgres start).
DATABASE_URL=postgresql+psycopg://ocd:ocd@localhost:5432/ocd
