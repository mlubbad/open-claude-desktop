{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Claude Desktop",
  "version": "0.1.0",
  "identifier": "com.openclaudedesktop.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Open Claude Desktop",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 ws://127.0.0.1:8000 http://localhost:8000 ws://localhost:8000; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/ocd-backend", "binaries/ocd-node"],
    "resources": []
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mlubbad/open-claude-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MzM0N0Q0QjdGQ0ZDOEEKUldTSy9QeTMxRWN6cEpOd3FlcnZ1ZWUwSnE3OWRnZDZINFhMdFlkSFVBQ1MrKytjQXBuRTVtcy8K"
    }
  }
}
