.git/
.github/
.claude/
.playwright-mcp/

# virtualenvs / build output
venv/
venv312/
**/.web/
**/node_modules/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# secrets / local env — mirrors .gitignore's secret-shaped patterns so a locally
# present key never gets baked into the image by `COPY . .`
.env
.env.*
!.env.example
*.key
*.pem
*.p12
ajgc-*.json
*-service-account*.json
*serviceaccount*.json
*-sa-*.json
*credentials*.json
.connector_secrets.json

# local runtime config — provide via mount/env in production; don't bake a
# developer's working copy into the image (connectors.json can hold API tokens)
settings.json
connectors.json
mcp_servers.json

# runtime data stores (regenerated)
chroma_db/
kuzu_db
kuzu_db.wal
logs/
projects/
projects.backup-*/
knowledge/
_sandbox/
agent_memory/
.files/

# docs / notes / scratch
docs/
aj360.md
aj360-*.md
*.csv
reflex_*.log
reflex_*.err

# the Reflex app builds as a separate image
frontend/
