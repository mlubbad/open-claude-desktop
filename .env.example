# ===========================================================================
# Open Claude Desktop — environment template
# Copy to ".env" and fill in. Keep .env out of git. Do NOT commit real secrets.
# For a local run you really only need the LLM provider section below; the rest
# is optional and has sensible local defaults.
# ===========================================================================

# ── Deployment posture ──────────────────────────────────────────────────────
# Hosted/public/multi-tenant launch is currently FROZEN. Keep this local for
# source/CLI use or use desktop for the packaged sidecar. `development` is only
# for the loopback-published Docker Compose stack. `hosted` and `public` refuse
# startup until the source-controlled launch freeze is reviewed and lifted.
OCD_DEPLOYMENT_MODE=local

# ── LLM provider (model-agnostic / BYOK) ────────────────────────────────────
# Pick any OpenAI-compatible provider and set ITS key. Built-in ids: openai,
# zhipu, deepseek, qwen, openrouter, together, groq, mistral, ollama, vllm,
# lmstudio, llamacpp. Keys are best stored via the in-app Settings (OS keychain);
# these env vars are a fallback. Local runtimes (ollama/vllm/…) need no key.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
AGENT_MODEL=llama-3.3-70b-versatile

# Other providers — uncomment the block you use instead of Groq:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AGENT_MODEL=gpt-4o-mini
#
# LLM_PROVIDER=ollama            # fully local, no key needed
# AGENT_MODEL=llama3.1
#
# For any other OpenAI-compatible endpoint, set these instead of a preset:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=your_key

# ── Tool permissions and capability opt-ins ─────────────────────────────────
# auto = run tools without prompting; ask = prompt before sensitive (default);
# tools (shell/code/file-writes/DB/external); strict = prompt before every tool.
PERMISSION_MODE=ask
# PERMISSION_TIMEOUT_SEC=300
# Containment defaults: Docker-only code execution, remote marketplaces off,
# child-process (stdio) MCP off, host execution off, and automations off.
CODE_EXECUTION_MODE=docker
# MARKETPLACE_ALLOW_REMOTE=1
# OCD_ENABLE_STDIO_MCP=1
# OCD_ALLOW_HOST_EXEC=1
# SCHEDULER_ENABLED=1

# ── Persistence (optional) ──────────────────────────────────────────────────
# Where conversations / projects / settings are stored. For a zero-setup local
# run a SQLite file is easiest (the schema is auto-created on first start).
DATABASE_URL=sqlite:///./ocd.db
# Never silently switch a configured primary database to local SQLite. A trusted
# local operator may set 1 temporarily, accepting degraded/split persistence.
OCD_DB_FALLBACK=0
# To use Postgres instead (e.g. via `docker compose up`), comment the line above
# to take the default (postgresql+psycopg://ocd:ocd@localhost:5432/ocd) and set:
# POSTGRES_PASSWORD=changeme

# ── Authentication ──────────────────────────────────────────────────────────
# Loopback single-user source/desktop mode may run open. ALL THREE values are
# mandatory whenever OCD_MULTI_TENANT=1 or OCD_BIND_HOST is non-loopback. Docker
# Compose binds 0.0.0.0 internally, so Compose users must set them. No insecure
# network flag bypasses this requirement. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_AUTH_SECRET=paste_a_generated_secret_here
# APP_USERNAME=you
# APP_PASSWORD=choose_a_strong_password

# ── Temporary containment limits ────────────────────────────────────────────
# Direct launches enforce these in ASGI; Docker Compose also enforces matching
# request/concurrency/rate limits in its Nginx edge proxy.
OCD_MAX_REQUEST_BYTES=33554432
OCD_MAX_CONCURRENT_REQUESTS=32
OCD_MAX_UPLOAD_BYTES=26214400

# ── BigQuery connector (optional; OFF unless configured) ────────────────────
# The app is a general assistant by default. BigQuery auto-enables when
# GCP_PROJECT_ID is set (authenticate via `gcloud auth application-default login`;
# never commit a service-account key). Force on/off with BIGQUERY_ENABLED.
# GCP_PROJECT_ID=
# BIGQUERY_ENABLED=true
# CATALOG_DATASETS=dataset_a,dataset_b
# MAX_BYTES_BILLED_GB=20

# Docker image for the code-execution sandbox. Unset: a locally built
# `ocd-sandbox:latest` (docker build -t ocd-sandbox backend/sandbox — office/data
# libs preinstalled) is auto-used when present, else python:3.11-slim.
# CODE_EXEC_IMAGE=ocd-sandbox:latest
