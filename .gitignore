# ───────────────────────────────────────────────────────────────────
#  Secrets & credentials — DENY BY DEFAULT. Never commit real secrets.
# ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# GCP service-account keys (the leaked ajgc-* key + any future key dumps)
ajgc-*.json
*-service-account*.json
*serviceaccount*.json
*-sa-*.json
*.key
*.pem
*.p12
*credentials*.json
# REST connector auth tokens (sidecar to the tracked connectors.json)
.connector_secrets.json

# ── Virtualenvs ────────────────────────────────────────────────────
venv/
venv312/

# ── Local data stores / caches / logs / sandboxes ──────────────────
logs/
chroma_db/
kuzu_db
kuzu_db.wal
_sandbox/
agent_memory/
__pycache__/
*.pyc
*.pyo
reflex_*.log
reflex_*.err

# ── Proprietary / runtime DATA — do NOT version (was publicly exposed 2026-06-26) ──
# Chat transcripts, uploaded files, AJ360 dataset dumps, project workspaces.
projects/
# migration backups written by ocd_core.db.migrate
projects.backup-*/
.files/
knowledge/
aj360.md
aj360-*.md
*.csv

# NOTE: non-secret config (mcp_servers.json, connectors.json,
# settings.json, package.json, reflex configs) is intentionally
# NOT ignored — only secret-shaped files are.

# Playwright MCP scratch (browser smoke tests)
.playwright-mcp/

# Reflex app is NOT a Chainlit app — keep its stray .chainlit/ scaffold out
frontend/.chainlit/

# Python build / tool caches
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
